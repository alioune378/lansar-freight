# Copy to .env and fill in. Never commit .env.
NODE_ENV=production
PORT=3000
BASE_URL=https://lansarfs.com
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=
DATA_DIR=data

# Transactional email: outbox (hold in dashboard only) | resend | postmark
MAIL_PROVIDER=outbox
RESEND_API_KEY=
POSTMARK_TOKEN=
MAIL_FROM=LANSAR Freight Shipping <no-reply@lansarfs.com>
MAIL_REPLY_TO=
# Who is notified about new quotes and cases (comma-separated)
STAFF_NOTIFY_EMAILS=
# Public contact email shown on the Contact page (leave blank until confirmed)
PUBLIC_EMAIL=

# Analytics (optional)
GA4_MEASUREMENT_ID=
PLAUSIBLE_DOMAIN=
